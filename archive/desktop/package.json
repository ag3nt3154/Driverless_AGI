{
  "name": "dagi-desktop",
  "version": "0.1.0",
  "description": "DAGI Electron desktop GUI",
  "main": ".vite/build/main.js",
  "author": "ag3nt3154",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true,
        "name": "DAGI",
        "executableName": "dagi-desktop"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "linux"
          ]
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-auto-unpack-natives",
          "config": {}
        },
        {
          "name": "@electron-forge/plugin-vite",
          "config": {
            "build": [
              {
                "entry": "src/main/main.ts",
                "config": "vite.main.config.ts",
                "target": "main"
              },
              {
                "entry": "src/main/preload.ts",
                "config": "vite.preload.config.ts",
                "target": "preload"
              }
            ],
            "renderer": [
              {
                "name": "main_window",
                "config": "vite.renderer.config.ts"
              }
            ]
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.0",
    "@electron-forge/maker-squirrel": "^7.11.0",
    "@electron-forge/maker-zip": "^7.11.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.0",
    "@electron-forge/plugin-vite": "^7.11.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "electron-window-state": "^5.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.1.0",
    "rehype-sanitize": "^6.0.0"
  }
}
